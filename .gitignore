# Virtualenv / conda
venv/
env/
.venv/
.env

# Data — MM-SafetyBench parquets are 200MB each; users download via data/README.md
data/mm_safetybench/*.parquet

# Experiment outputs — regenerated by scripts/reproduce.sh
# Keep summary.json and aggregated/ committed; ignore the heavy per-record CSV/JSON
experiments/results/*/records.csv
experiments/results/*/records.json
experiments/results/*/preview_images/
experiments/results/conformal_verification/results.json
logs/

# HuggingFace cache (multi-GB models — users download via scripts/setup.sh)
.cache/
hf_cache/

# Local editor / tool state
.claude/
graphify-out/

# Paper source — kept local, excluded from public/shared repo
paper/

# LaTeX build artifacts (in case paper/ is ever re-added)
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fls
paper/*.fdb_latexmk
paper/*.log
paper/*.out
paper/*.synctex.gz
paper/*.toc
paper/main.pdf

